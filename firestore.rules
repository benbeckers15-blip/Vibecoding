rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read-only collections ─────────────────────────────────────────
    // Editorial / reference data anyone can browse, even unauthenticated.
    // No write access from the client — all writes go through Admin SDK scripts.

    match /wineries/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Per-winery wine list (also the source for the concierge's wine
    // index — see scripts/rag/ingest-tasting-notes.js). Read by the
    // winery detail "Wines" tab; writes only via Admin SDK / Sheets sync.
    match /wines/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /homepage_carousel/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /premade_trips/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /explore_articles/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /pour_articles/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // RAG knowledge base — chunked editorial prose + tasting notes the
    // concierge retrieves at query time. Written by scripts/rag/ingest.js
    // via Admin SDK; clients only ever read.
    match /knowledge_chunks/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // App-wide config (e.g. config/homepage.heroImageUrl). Public read so the
    // home screen can fetch the current hero image; writes only via Admin SDK.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Per-region config (display name, regional primer, sub-regions, picker
    // prompts, map bounds). Read on every app launch by RegionContext and
    // on every concierge cold-start per region. Owned by content team;
    // writes only via Admin SDK (see scripts/seed-region-*.js).
    match /regions/{regionId} {
      allow read: if true;
      allow write: if false;
    }

    // Concierge per-session daily quota counters. Written by the Cloud
    // Function on every concierge turn (via firebase-admin, bypassing
    // rules). Clients have no business reading or writing these — a
    // client that could read them could enumerate other users' session
    // IDs, and one that could write could zero its own counter. Locked
    // down to admin-only.
    //
    // Cleanup: configure a Firestore TTL policy on the `expiresAt`
    // field for this collection (one-time setup, see rateLimit.ts).
    match /concierge_rate_limits/{doc} {
      allow read, write: if false;
    }

    // ── Community tasting notes ──────────────────────────────────────────────
    // Public notes shown on each winery's "Tasting Notes" tab. Anyone can
    // read; signed-in users may create notes attributed to themselves and
    // may only modify/delete their own. Field checks keep payloads sane.
    match /winery_tastings/{doc} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.winerySlug is string
        && request.resource.data.wine is string
        && request.resource.data.wine.size() > 0
        && request.resource.data.wine.size() <= 120
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ── Per-user collections ─────────────────────────────────────────────────
    // Only the signed-in user may read or write their own document.

    // Top-level user doc + all subcollections (savedWineries, savedArticles,
    // lists, tastings, etc.) — owner-only access.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
